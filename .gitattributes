# 默认：自动识别文本文件，仓库内统一存为 LF
* text=auto eol=lf

# 源码与配置
*.ts   text
*.js   text
*.json text
*.yaml text
*.yml  text
*.md   text

# Windows 脚本必须保留 CRLF，否则部分环境执行报错
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件：不做行尾转换，不参与 diff 文本统计
*.xlsx binary
*.xlsm binary
*.xls  binary
*.docx binary
*.docm binary
*.doc  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary

# GitHub 语言统计：把样例 Excel/Word 排除掉，避免仓库被识别成 Office 文档项目
samples/* linguist-generated=true
package-lock.json linguist-generated=true
