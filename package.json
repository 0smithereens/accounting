    "cli": "node src/cli.ts",
    "web": "node src/web/server.ts",
    "check": "node src/cli.ts check"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "mammoth": "^1.8.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "jszip": "^3.10.2",
    "typescript": "^5.8.2"
  }
