{
  "name": "accounting-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "会计自动化记账系统：识别 Excel/Word 单据，通过规则引擎生成标准借贷会计分录并导出凭证",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
